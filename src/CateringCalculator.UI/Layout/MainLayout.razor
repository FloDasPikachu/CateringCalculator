@inherits LayoutComponentBase
@inject CateringCalculator.UI.Services.LocalizationService LocalizationService

<div class="app-shell">
    @* Safe Area Handling für iOS Statusleiste *@
    <div class="status-bar-safe-area"></div>

    <header class="top-navbar">
        <div class="brand">
            <span class="brand-icon">🍹</span>
            <span class="brand-title">Catering Calculator</span>
        </div>

        <div style="display: flex; align-items: center; gap: 1rem;">
            <!-- Sprachschalter -->
            <div class="language-switcher" style="display: flex; gap: 0.25rem;">
                <button class="btn @(LocalizationService.CurrentCulture.TwoLetterISOLanguageName == "de" ? "btn-primary" : "btn-outline-secondary") btn-sm"
                        style="padding: 0.2rem 0.5rem; font-size: 0.8rem;"
                        @onclick='() => LocalizationService.SetCulture("de")'>
                    DE
                </button>
                <button class="btn @(LocalizationService.CurrentCulture.TwoLetterISOLanguageName == "en" ? "btn-primary" : "btn-outline-secondary") btn-sm"
                        style="padding: 0.2rem 0.5rem; font-size: 0.8rem;"
                        @onclick='() => LocalizationService.SetCulture("en")'>
                    EN
                </button>
            </div>

            <NavMenu />
        </div>
    </header>

    <main class="content-body">
        <div class="content-wrapper">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>