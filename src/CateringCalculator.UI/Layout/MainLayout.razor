@inherits LayoutComponentBase
@using Microsoft.Maui.Devices

<div class="app-shell">
    @* Safe Area Handling für iOS/Android Notches *@
    <div class="status-bar-safe-area"></div>

    <header class="top-navbar">
        <div class="brand">
            <span class="brand-icon">🍹</span>
            <span class="brand-title">Catering Calculator</span>
        </div>

        <!-- Header Rechts (Desktop-Navigation & Sprachschalter) -->
        <div class="header-right">
            @if (IsMobileDevice) {
                @* Auf echtem Smartphone: Nur Sprachschalter oben, Menü ist unten *@
            } else {
                @* 1. Permanente Desktop-Leiste (wird bei breitem Fenster direkt angezeigt, bei schmalem ausgeblendet) *@
                <div class="desktop-menu">
                    <NavMenu IsMobile="false" />
                </div>

                @* 2. Hamburger-Button (erscheint nur bei schmalem Desktop-Fenster via CSS) *@
                <button class="hamburger-btn" @onclick="ToggleDesktopMenu" aria-label="Menu">
                    <span></span><span></span><span></span>
                </button>

                @* 3. Dropdown-Menü für den Hamburger *@
                <div class="desktop-nav @(_isDesktopMenuOpen ? "open" : "")">
                    <NavMenu IsMobile="false" OnItemSelected="CloseDesktopMenu" />
                </div>
            }

            <div class="language-switcher">
                <button class="btn-lang @(IsGermanActive ? "active" : "")" @onclick='() => ChangeLanguage("de")'>DE</button>
                <button class="btn-lang @(IsEnglishActive ? "active" : "")" @onclick='() => ChangeLanguage("en")'>EN</button>
            </div>
        </div>
    </header>

    <main class="content-body">
        <div class="content-wrapper">
            @Body
        </div>
    </main>

    @* Mobile Bottom Navigation: EXKLUSIV nur auf echten Smartphones *@
    @if (IsMobileDevice) {
        <div class="mobile-nav">
            <NavMenu IsMobile="true" />
        </div>
    }
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>