@using CateringCalculator.Resources.Internationalization

@if (IsVisible) {
    <div class="modal-backdrop">
        <div class="modal-card" style="max-width: 600px; width: 90%; max-height: 80vh; overflow-y: auto;">
            <div class="modal-header">
                <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600;">@AppResources.FixedModal_Title</h3>
                <button type="button" class="btn-close-custom" @onclick="OnClose">✕</button>
            </div>

            <div class="modal-body">
                @if (_items.Any()) {
                    <div style="display: flex; gap: 0.5rem; padding: 0 0.5rem; margin-bottom: 0.3rem; font-size: 0.75rem; font-weight: 600;" class="text-muted">
                        <div style="flex: 2;">@AppResources.FixedModal_DescPlaceholder</div>
                        <div style="width: 120px; text-align: right;">@AppResources.FixedModal_AmountHeader</div>
                        <div style="width: 38px;"></div>
                    </div>
                }

                @foreach (var item in _items) {
                    <div class="modal-item-row">
                        <input type="text" class="form-control" placeholder="@AppResources.FixedModal_DescPlaceholder" @bind="item.Description" style="flex: 2;" />
                        <input type="number" class="form-control" placeholder="@AppResources.FixedModal_AmountHeader" @bind="item.Amount" min="0" step="10" style="width: 120px; text-align: right;" />
                        <button class="btn-secondary" style="color: #dc3545; padding: 0.4rem 0.6rem;" title="@AppResources.Button_Delete" @onclick="() => _items.Remove(item)">🗑️</button>
                    </div>
                }

                <button class="btn-secondary" style="width: 100%; margin-bottom: 1.25rem;" @onclick="AddFixedItem">➕ @AppResources.FixedModal_AddPosition</button>

                <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 0.75rem;">
                    <strong style="font-size: 1rem;">@AppResources.FixedModal_Total @_items.Sum(x => x.Amount).ToString("N2") €</strong>
                    <button class="btn-primary" @onclick="() => OnSave.InvokeAsync(_items)">@AppResources.Button_Save</button>
                </div>
            </div>
        </div>
    </div>
}
