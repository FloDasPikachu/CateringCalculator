@if (IsVisible) {
    <div class="modal-backdrop">
        <div class="modal-card" style="max-width: 650px; width: 90%; max-height: 80vh; overflow-y: auto;">
            <div class="modal-header">
                <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600;">@AppResources.PersonnelModal_Title</h3>
                <button type="button" class="btn-close-custom" @onclick="OnClose">✕</button>
            </div>

            <div class="modal-body">
                @if (_items.Any()) {
                    <div style="display: flex; gap: 0.5rem; padding: 0 0.5rem; margin-bottom: 0.3rem; font-size: 0.75rem; font-weight: 600;" class="text-muted">
                        <div style="flex: 2;">@AppResources.PersonnelModal_RolePlaceholder</div>
                        <div style="width: 70px; text-align: center;">@AppResources.PersonnelModal_CountHeader</div>
                        <div style="width: 80px; text-align: center;">@AppResources.PersonnelModal_HoursHeader</div>
                        <div style="width: 80px; text-align: center;">@AppResources.PersonnelModal_RateHeader</div>
                        <div style="width: 38px;"></div>
                    </div>
                }

                @foreach (var item in _items) {
                    <div class="modal-item-row">
                        <input type="text" class="form-control" placeholder="@AppResources.PersonnelModal_RolePlaceholder" @bind="item.RoleName" style="flex: 2;" />
                        <input type="number" class="form-control" title="Anzahl Personen" @bind="item.Count" min="1" style="width: 70px; text-align: center;" />
                        <input type="number" class="form-control" title="Arbeitsstunden" @bind="item.Hours" min="0.5" step="0.5" style="width: 80px; text-align: center;" />
                        <input type="number" class="form-control" title="Stundensatz in Euro" @bind="item.HourlyRate" min="0" step="0.5" style="width: 80px; text-align: right;" />
                        <button class="btn-secondary" style="color: #dc3545; padding: 0.4rem 0.6rem;" title="@AppResources.Button_Delete" @onclick="() => _items.Remove(item)">🗑️</button>
                    </div>
                }

                <button class="btn-secondary" style="width: 100%; margin-bottom: 1.25rem;" @onclick="AddPersonnelItem">➕ @AppResources.PersonnelModal_AddPosition</button>

                <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 0.75rem;">
                    <strong style="font-size: 1rem;">@AppResources.PersonnelModal_Total @_items.Sum(x => x.TotalCost).ToString("N2") €</strong>
                    <button class="btn-primary" @onclick="() => OnSave.InvokeAsync(_items)">@AppResources.Button_Save</button>
                </div>
            </div>
        </div>
    </div>
}
