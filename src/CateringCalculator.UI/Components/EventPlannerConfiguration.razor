<div class="event-plan-container">

    <!-- 1. Event-Parameters Panel -->
    <details class="card-panel" open>
        <summary class="panel-summary">
            <h3 class="panel-title">
                @AppResources.Event_Section1Title
            </h3>
            <span class="panel-chevron">▼</span>
        </summary>

        <div class="panel-body">
            <div class="form-group">
                <label class="form-label">@AppResources.Event_NameLabel</label>
                <input type="text" class="form-control" @bind="EventPlan.Title" placeholder="z. B. Sommerfest 2026" />
            </div>

            <div class="form-row">
                <div class="form-group flex-1">
                    <label class="form-label">@AppResources.Event_GuestCount</label>
                    <input type="number" class="form-control" @bind="EventPlan.GuestCount" min="1" />
                </div>
                <div class="form-group flex-1">
                    <label class="form-label">@AppResources.Event_DrinksPerGuest</label>
                    <input type="number" class="form-control" @bind="EventPlan.AverageDrinksPerGuest" min="1" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group flex-1">
                    <label class="form-label">@AppResources.Event_FreeDrinks</label>
                    <input type="number" class="form-control" @bind="EventPlan.FreeDrinksCount" min="0" />
                    <span class="form-hint">@AppResources.Event_FreeDrinksHint</span>
                </div>
                <div class="form-group flex-1">
                    <label class="form-label">@AppResources.Event_WasteBuffer</label>
                    <input type="number" class="form-control" @bind="EventPlan.WasteBufferPercent" min="0" max="50" />
                </div>
            </div>
        </div>
    </details>

    <!-- 2. Financial Parameters -->
    <details class="card-panel" open>
        <summary class="panel-summary">
            <h3 class="panel-title">
                @AppResources.Event_Section2Title
            </h3>
            <span class="panel-chevron">▼</span>
        </summary>

        <div class="panel-body">
            <div class="form-row">
                <div class="form-group flex-1">
                    <label class="form-label">@AppResources.Event_FixedCosts</label>
                    <div class="input-group-action">
                        <input type="number" class="form-control" @bind="EventPlan.FixedCosts" min="0" step="10" />
                        <button type="button" class="btn-secondary btn-action" @onclick="OpenFixedModal" title="Fixkosten im Detail berechnen">⚙️ @AppResources.Button_Details</button>
                    </div>
                    <span class="form-hint">@AppResources.Event_FixedCostsHint</span>
                </div>

                <div class="form-group flex-1">
                    <label class="form-label">@AppResources.Event_PersonnelCosts</label>
                    <div class="input-group-action">
                        <input type="number" class="form-control" @bind="EventPlan.PersonnelCosts" min="0" step="10" />
                        <button type="button" class="btn-secondary btn-action" @onclick="OpenPersonnelModal" title="Personalkosten im Detail berechnen">⚙️ @AppResources.Button_Details</button>
                    </div>
                    <span class="form-hint">@AppResources.Event_PersonnelCostsHint</span>
                </div>
            </div>

            <div class="form-group mb-0">
                <label class="form-label">@AppResources.Event_TargetProfit</label>
                <input type="number" class="form-control" @bind="EventPlan.TargetProfit" min="0" step="50" />
                <span class="form-hint mt-xs">
                    @AppResources.Event_TargetProfitHint
                </span>
            </div>
        </div>
    </details>

    <!-- 3. Cocktails selection Panel -->
    <details class="card-panel" open>
        <summary class="panel-summary">
            <h3 class="panel-title">@AppResources.Event_Section3Title</h3>
            <span class="panel-chevron">▼</span>
        </summary>

        <div class="panel-body">
            @if (_availableRecipes.Count == 0) {
                <div class="warning-box mb-3">
                    @AppResources.Event_NoRecipesWarning
                </div>
            } else {
                <div class="recipe-list-container">
                    @foreach (var recipe in _availableRecipes) {
                        var selection = EventPlan.SelectedRecipes.FirstOrDefault(r => r.RecipeId == recipe.Id);
                        var isSelected = selection != null;

                        <div class="recipe-item @(isSelected ? "selected" : "")">
                            <div class="recipe-header">
                                <label class="recipe-label">
                                    <input type="checkbox"
                                           checked="@isSelected"
                                           @onchange="() => ToggleRecipeSelection(recipe)" />
                                    @recipe.Name
                                </label>
                                <span class="badge badge-primary">
                                    @recipe.TotalCostPerDrink.ToString("N2") € / Drink
                                </span>
                            </div>

                            @if (isSelected && selection != null) {
                                <div class="recipe-share-row">
                                    <span class="text-muted text-sm">@AppResources.Event_ShareLabel</span>
                                    <input type="range" class="recipe-range" min="0" max="100" step="5"
                                           @bind="selection.Percentage" @bind:event="oninput" />
                                    <div class="recipe-percentage-input-group">
                                        <input type="number" class="form-control input-sm text-right" min="0" max="100"
                                               @bind="selection.Percentage" />
                                        <span class="text-sm">%</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (EventPlan.SelectedRecipes.Count > 0) {
                    var totalPercent = TotalPercentage;
                    var is100 = totalPercent == 100m;
                    <div class="distribution-status-box @(is100 ? "success" : "danger")">
                        <div class="distribution-status-text">
                            <span>@AppResources.Event_TotalDistribution</span>
                            <strong>@totalPercent % @(is100 ? "✓" : AppResources.Event_MustBe100)</strong>
                        </div>
                        <button type="button" class="btn-secondary btn-sm" @onclick="DistributeEvenly">
                            ⚖️ @AppResources.Event_DistributeEvenly
                        </button>
                    </div>
                }
            }
        </div>
    </details>

    <!-- 4. Inventory / Stock Management Panel -->
    <details class="card-panel">
        <summary class="panel-summary">
            <h3 class="panel-title">
                @AppResources.Event_StockManagementTitle
            </h3>
            <span class="panel-chevron">▼</span>
        </summary>

        <div class="panel-body">
            <p class="text-muted text-sm mb-3">
                @AppResources.Event_StockManagementHint
            </p>

            @if (EventPlan.SelectedRecipes.Count == 0) {
                <div class="text-muted text-sm italic">
                    @AppResources.Event_SelectRecipesFirst
                </div>
            } else {
                <div class="table-scroll-container">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>@AppResources.Ingredients_Name</th>
                                <th class="text-right">@AppResources.Ingredients_StockAmount</th>
                                <th class="unit-col">Einheit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ingredient in GetUniqueIngredientsForSelectedRecipes()) {
                                <tr>
                                    <td>@ingredient.Name</td>
                                    <td class="text-right">
                                        <input type="number" class="form-control input-xs text-right inline-input"
                                               @bind="ingredient.StockAmount" min="0" step="0.1" />
                                    </td>
                                    <td class="text-muted">@ingredient.Unit</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </details>

    <div class="card-panel action-panel">
        <button type="button" class="btn-primary w-100 py-md"
                @onclick="CalculateEvent"
                disabled="@(EventPlan.SelectedRecipes.Count == 0 || EventPlan.GuestCount <= 1 || TotalPercentage != 100m)">
            🧮 @AppResources.Event_CalculateBtn
        </button>
    </div>
</div>

<PersonnelCostModal IsVisible="_showPersonnelModal"
                    PersonnelItems="EventPlan.PersonnelCostItems"
                    EventPlanId="EventPlan.Id"
                    OnSave="SavePersonnelModal"
                    OnClose="ClosePersonnelModal" />

<FixedCostModal IsVisible="_showFixedModal"
                FixedItems="EventPlan.FixedCostItems"
                EventPlanId="EventPlan.Id"
                OnSave="SaveFixedModal"
                OnClose="CloseFixedModal" />