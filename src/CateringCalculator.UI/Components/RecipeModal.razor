@using CateringCalculator.Core.Enums
@using CateringCalculator.Core.Models
@using CateringCalculator.UI.Resources.Internationalization

@if (IsVisible) {
    <div class="modal-backdrop">
        <div class="modal-card" style="max-width: 700px; width: 90%;">
            <div class="modal-header">
                <h3 style="margin: 0;">
                    @(IsEditing ? AppResources.RecipeModal_TitleEdit : AppResources.RecipeModal_TitleNew)
                </h3>
                <button type="button" class="btn-close-custom" @onclick="OnClose">✕</button>
            </div>

            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">@AppResources.RecipeModal_NameLabel</label>
                    <input type="text" class="form-control" @bind="Recipe.Name" placeholder="@AppResources.RecipeModal_NamePlaceholder" />
                </div>

                <div class="form-group">
                    <label class="form-label">@AppResources.RecipeModal_DescLabel</label>
                    <input type="text" class="form-control" @bind="Recipe.Description" placeholder="@AppResources.RecipeModal_DescPlaceholder" />
                </div>

                <!-- Gruppen / Tags Sektion -->
                <div class="form-group">
                    <label class="form-label">Gruppen / Tags</label>

                    <!-- Eingetragene Gruppen als Chips direkt über/neben dem Feld oder im Input -->
                    <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.5rem; align-items: center;">
                        @foreach (var tag in _currentTags) {
                            <span style="background-color: rgba(var(--primary-rgb, 99, 102, 241), 0.15); color: var(--primary); font-size: 0.8rem; padding: 0.2rem 0.5rem; border-radius: 4px; display: inline-flex; align-items: center; gap: 0.3rem; font-weight: 500;">
                                @tag
                                <button type="button" style="background: none; border: none; color: var(--primary); cursor: pointer; font-size: 0.9rem; padding: 0; line-height: 1;" @onclick="() => RemoveTag(tag)">×</button>
                            </span>
                        }
                    </div>

                    <div style="display: flex; gap: 0.5rem;">
                        <input type="text" class="form-control" @bind="_tagInput" @bind:event="oninput" placeholder="Neue Gruppe eingeben (mit Komma trennen)..." />
                        <button type="button" class="btn-secondary" style="padding: 0.3rem 0.75rem; font-size: 0.85rem;" @onclick="AddTagFromInput">Hinzufügen</button>
                    </div>

                    <!-- Live Vorschlag-Chips -->
                    @if (AvailableGroups != null && AvailableGroups.Any()) {
                        var unusedSuggestions = AvailableGroups.Where(g => !_currentTags.Contains(g, StringComparer.OrdinalIgnoreCase)).ToList();

                        if (unusedSuggestions.Any()) {
                            <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.5rem; align-items: center;">
                                <span style="font-size: 0.75rem; color: var(--text-muted); margin-right: 0.25rem;">Vorschläge:</span>
                                @foreach (var suggestion in unusedSuggestions) {
                                    <button type="button"
                                            style="background-color: rgba(var(--primary-rgb, 99, 102, 241), 0.08); border: 1px dashed var(--primary); color: var(--primary); font-size: 0.75rem; padding: 0.15rem 0.5rem; border-radius: 12px; cursor: pointer; transition: all 0.2s;"
                                            @onclick="() => AddGroupTag(suggestion)">
                                        + @suggestion
                                    </button>
                                }
                            </div>
                        }
                    }
                </div>

                <h4 style="font-size: 1rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.75rem;">
                    @AppResources.RecipeModal_IngredientsHeader
                </h4>

                <!-- Tabelle der hinzugefügten Zutaten -->
                @if (Recipe.Items.Count == 0) {
                    <div style="background-color: rgba(255, 193, 7, 0.1); border: 1px solid rgba(255, 193, 7, 0.3); border-radius: 6px; padding: 0.75rem; margin-bottom: 1rem; font-size: 0.875rem; color: #856404;">
                        @AppResources.RecipeModal_EmptyWarning
                    </div>
                } else {
                    <div style="overflow-x: auto; margin-bottom: 1rem;">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th>@AppResources.RecipeModal_TableIngredient</th>
                                    <th style="width: 140px;">@AppResources.RecipeModal_TableAmount</th>
                                    <th style="width: 60px; text-align: right;">@AppResources.RecipeModal_TableAction</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Recipe.Items) {
                                    var ing = AvailableIngredients.FirstOrDefault(i => i.Id == item.IngredientId);
                                    <tr>
                                        <td><strong>@(ing?.Name ?? item.Ingredient?.Name ?? AppResources.RecipeModal_UnknownIngredient)</strong></td>
                                        <td>@FormatAmount(item.Amount, ing?.Unit ?? item.Ingredient?.Unit)</td>
                                        <td style="text-align: right;">
                                            <button type="button" class="btn-secondary" style="padding: 0.2rem 0.5rem; color: #dc3545;" @onclick="() => RemoveItemFromRecipe(item)" title="@AppResources.Button_Delete">
                                                ✕
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <!-- Card zum Auswählen/Hinzufügen einer Zutat -->
                <div class="price-preview-box" style="margin-bottom: 1rem;">
                    <span style="font-weight: 600; display: block; margin-bottom: 0.5rem; font-size: 0.9rem;">
                        @AppResources.RecipeModal_AddSectionTitle
                    </span>

                    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: flex-end;">
                        <div style="flex: 2; min-width: 180px;">
                            <label class="form-label" style="font-size: 0.8rem;">@AppResources.RecipeModal_ExistingIngredientLabel</label>
                            <select class="form-control" value="@_selectedIngredientId" @onchange="OnIngredientSelectionChanged">
                                <option value="@Guid.Empty">@AppResources.RecipeModal_SelectOrNewOption</option>
                                @foreach (var ing in AvailableIngredients) {
                                    <option value="@ing.Id">@ing.Name (@ing.PackageSize @GetUnitSuffix(ing.Unit) - @ing.PackagePrice.ToString("N2") €)</option>
                                }
                            </select>
                        </div>

                        <div style="flex: 1; min-width: 120px;">
                            <label class="form-label" style="font-size: 0.8rem;">@string.Format(AppResources.RecipeModal_AmountLabel, GetSelectedIngredientUnitLabel())</label>
                            <input type="number" class="form-control" @bind="_amount" min="0.1" step="@_amountStep" />
                        </div>

                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                            <button type="button" class="btn-primary" style="padding: 0.5rem 0.75rem; font-size: 0.85rem;" @onclick="AddSelectedIngredientToRecipe" disabled="@(_selectedIngredientId == Guid.Empty || _amount <= 0)">
                                @AppResources.RecipeModal_AddBtn
                            </button>
                            <button type="button" class="btn-secondary" style="padding: 0.5rem 0.75rem; font-size: 0.85rem;" @onclick="ToggleNewIngredientFields">
                                @(_showNewIngredientInput ? AppResources.RecipeModal_CancelBtn : AppResources.RecipeModal_NewIngredientBtn)
                            </button>
                        </div>
                    </div>

                    <!-- Unter-Formular für völlig neue Zutat -->
                    @if (_showNewIngredientInput) {
                        <div style="border-top: 1px solid rgba(0,0,0,0.1); margin-top: 0.75rem; padding-top: 0.75rem;">
                            <span style="font-weight: 600; color: var(--primary); display: block; margin-bottom: 0.5rem; font-size: 0.85rem;">
                                @AppResources.RecipeModal_NewCatalogTitle
                            </span>
                            <div class="form-row" style="margin-bottom: 0.5rem;">
                                <div class="form-group" style="flex: 2;">
                                    <label class="form-label" style="font-size: 0.8rem;">@AppResources.RecipeModal_NewIngNameLabel</label>
                                    <input type="text" class="form-control" @bind="_newIngName" placeholder="@AppResources.RecipeModal_NewIngNamePlaceholder" />
                                </div>
                                <div class="form-group" style="flex: 1;">
                                    <label class="form-label" style="font-size: 0.8rem;">@AppResources.RecipeModal_NewIngUnitLabel</label>
                                    <select class="form-control" @bind="_newIngUnit">
                                        <option value="@IngredientUnit.Milliliter">Milliliter (ml)</option>
                                        <option value="@IngredientUnit.Piece">Stück (Stk.)</option>
                                        <option value="@IngredientUnit.Gram">Gramm (g)</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-row" style="margin-bottom: 0.75rem;">
                                <div class="form-group" style="flex: 1;">
                                    <label class="form-label" style="font-size: 0.8rem;">@AppResources.RecipeModal_NewIngSizeLabel</label>
                                    <input type="number" class="form-control" @bind="_newIngSize" step="1" />
                                </div>
                                <div class="form-group" style="flex: 1;">
                                    <label class="form-label" style="font-size: 0.8rem;">@AppResources.RecipeModal_NewIngPriceLabel</label>
                                    <input type="number" class="form-control" @bind="_newIngPrice" step="0.01" />
                                </div>
                            </div>
                            <button type="button" class="btn-primary" style="width: 100%; font-size: 0.85rem;" @onclick="CreateAndAddIngredientAsync">
                                @AppResources.RecipeModal_CreateAndAssignBtn
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="OnClose">@AppResources.RecipeModal_CancelBtn</button>
                <button type="button" class="btn-primary" @onclick="async () => { PrepareRecipeBeforeSave(); await OnSave.InvokeAsync(Recipe); }" disabled="@(string.IsNullOrWhiteSpace(Recipe.Name) || Recipe.Items.Count == 0 || IsSaving)">
                    @if (IsSaving) {
                        <span>@AppResources.RecipeModal_Saving</span>
                    } else {
                        <span>💾 @AppResources.Button_Save</span>
                    }
                </button>
            </div>
        </div>
    </div>
}