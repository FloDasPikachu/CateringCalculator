@page "/event-planner"
@using CateringCalculator.Core.Enums
@using CateringCalculator.Core.Interfaces
@using CateringCalculator.Core.Models
@using CateringCalculator.Core.Services
@inject IRecipeRepository RecipeRepository
@inject IEventPlanRepository EventPlanRepository
@inject CalculationService CalculationService
@inject CateringCalculator.UI.Services.FileSaveService FileSaveService

<PageTitle>Event-Planung - Catering Calculator</PageTitle>

<div class="page-container">
    <!-- Header-Bereich -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Event-Planung & Kalkulation</h1>
            <p class="text-muted" style="margin-bottom: 0;">Berechne die benötigten Zutaten, Gebinde, Fixkosten und Ziel-Verkaufspreise.</p>
        </div>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <button class="btn-primary" @onclick="CreateNewEvent">
                <span>➕</span> Neues Event
            </button>
            <button class="btn-primary" @onclick="SaveCurrentEvent" disabled="@(string.IsNullOrWhiteSpace(_eventPlan.Title))" style="background-color: #28a745;">
                <span>💾</span> Speichern
            </button>
            @if (_savedEventPlans.Any(p => p.Id == _eventPlan.Id))
            {
                <button class="btn-secondary" @onclick="DeleteCurrentEvent" style="color: #dc3545;">
                    <span>🗑️</span> Löschen
                </button>
            }
        </div>
    </div>

    <!-- Event-Auswahl-Panel -->
    <div class="card-panel" style="margin-bottom: 1.5rem; padding: 1rem 1.25rem;">
        <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
            <label style="font-weight: 600; white-space: nowrap; font-size: 0.95rem;">Gespeichertes Event:</label>
            <select class="form-control" style="flex: 1; min-width: 240px;" @onchange="OnEventSelected" value="@(_eventPlan.Id.ToString())">
                <option value="@Guid.Empty.ToString()">-- Neues Event (nicht gespeichert) --</option>
                @foreach (var plan in _savedEventPlans)
                {
                    <option value="@plan.Id.ToString()">@plan.Title (@plan.GuestCount Gäste)</option>
                }
            </select>
        </div>
    </div>

    <!-- Haupt-Content Layout (2-Spalten Grid) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 1.5rem; align-items: start;">
        
        <!-- Linke Spalte: Konfiguration & Rezeptauswahl -->
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            
            <!-- 1. Event-Parameters Panel -->
            <div class="card-panel">
                <h3 style="margin: 0 0 1rem 0; font-size: 1.1rem; font-weight: 600; border-bottom: 1px solid rgba(0,0,0,0.08); padding-bottom: 0.5rem;">
                    1. Event-Parameter & Mengen
                </h3>

                <div class="form-group">
                    <label class="form-label">Veranstaltungsname *</label>
                    <input type="text" class="form-control" @bind="_eventPlan.Title" placeholder="z. B. Sommerfest 2026" />
                </div>

                <div class="form-row">
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">Anzahl Gäste</label>
                        <input type="number" class="form-control" @bind="_eventPlan.GuestCount" min="1" />
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">Drinks / Gast</label>
                        <input type="number" class="form-control" @bind="_eventPlan.AverageDrinksPerGuest" min="1" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">Freigetränke (Stk.)</label>
                        <input type="number" class="form-control" @bind="_eventPlan.FreeDrinksCount" min="0" />
                        <span class="text-muted" style="font-size: 0.75rem; display: block; margin-top: 0.2rem;">Fließen als Kostentreiber in den Wareneinsatz.</span>
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">Schwund-Puffer (%)</label>
                        <input type="number" class="form-control" @bind="_eventPlan.WasteBufferPercent" min="0" max="50" />
                    </div>
                </div>
            </div>

            <!-- 2. Finanzielle Parameter (Fixkosten & Personal) -->
            <div class="card-panel">
                <h3 style="margin: 0 0 1rem 0; font-size: 1.1rem; font-weight: 600; border-bottom: 1px solid rgba(0,0,0,0.08); padding-bottom: 0.5rem;">
                    2. Kosten & Wunschgewinn
                </h3>

                <div class="form-row">
                    <!-- Fixkosten mit Modal-Button -->
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">Fixkosten (€)</label>
                        <div style="display: flex; gap: 0.5rem;">
                            <input type="number" class="form-control" @bind="_eventPlan.FixedCosts" min="0" step="10" style="flex: 1;" />
                            <button type="button" class="btn-secondary" @onclick="OpenFixedModal" style="padding: 0.35rem 0.6rem; white-space: nowrap;" title="Fixkosten im Detail berechnen">⚙️ Details</button>
                        </div>
                        <span class="text-muted" style="font-size: 0.75rem; display: block; margin-top: 0.2rem;">Miete, Müll, Pauschalen etc.</span>
                    </div>

                    <!-- Personalkosten mit Modal-Button -->
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">Personalkosten (€)</label>
                        <div style="display: flex; gap: 0.5rem;">
                            <input type="number" class="form-control" @bind="_eventPlan.PersonnelCosts" min="0" step="10" style="flex: 1;" />
                            <button type="button" class="btn-secondary" @onclick="OpenPersonnelModal" style="padding: 0.35rem 0.6rem; white-space: nowrap;" title="Personalkosten im Detail berechnen">⚙️ Details</button>
                        </div>
                        <span class="text-muted" style="font-size: 0.75rem; display: block; margin-top: 0.2rem;">Gesamtlohn Service/Bar.</span>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label">Wunschgewinn (€)</label>
                    <input type="number" class="form-control" @bind="_eventPlan.TargetProfit" min="0" step="50" />
                    <span class="text-muted" style="font-size: 0.75rem; display: block; margin-top: 0.25rem;">
                        Netto-Gewinnziel, das auf die zahlenden Drinks umgelegt wird.
                    </span>
                </div>
            </div>

            <!-- 3. Cocktails auswählen Panel -->
            <div class="card-panel">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid rgba(0,0,0,0.08); padding-bottom: 0.5rem;">
                    <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600;">3. Cocktails auswählen</h3>
                    @if (_eventPlan.SelectedRecipes.Count > 0)
                    {
                        <button type="button" class="btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;" @onclick="DistributeEvenly">
                            ⚖️ Gleichmäßig verteilen
                        </button>
                    }
                </div>

                @if (_availableRecipes.Count == 0)
                {
                    <div style="background-color: rgba(255, 193, 7, 0.1); border: 1px solid rgba(255, 193, 7, 0.3); border-radius: 6px; padding: 0.75rem; font-size: 0.875rem; color: #856404;">
                        Keine Rezepte vorhanden. Bitte erst unter "Rezepte" Cocktails anlegen!
                    </div>
                }
                else
                {
                    <div style="max-height: 280px; overflow-y: auto; margin-bottom: 1rem; border: 1px solid rgba(0,0,0,0.08); border-radius: 6px;">
                        @foreach (var recipe in _availableRecipes)
                        {
                            var selection = _eventPlan.SelectedRecipes.FirstOrDefault(r => r.RecipeId == recipe.Id);
                            var isSelected = selection != null;

                            <div style="padding: 0.75rem 1rem; border-bottom: 1px solid rgba(0,0,0,0.05); background-color: @(isSelected ? "rgba(var(--primary-rgb, 13, 110, 253), 0.05)" : "transparent");">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; cursor: pointer; margin: 0; font-size: 0.95rem;">
                                        <input type="checkbox"
                                               checked="@isSelected"
                                               @onchange="() => ToggleRecipeSelection(recipe)" />
                                        @recipe.Name
                                    </label>
                                    <span class="badge badge-primary">
                                        @recipe.TotalCostPerDrink.ToString("C2") / Drink
                                    </span>
                                </div>

                                @if (isSelected && selection != null)
                                {
                                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px dashed rgba(0,0,0,0.1);">
                                        <span class="text-muted" style="font-size: 0.8rem;">Anteil:</span>
                                        <input type="range" style="flex: 1;" min="0" max="100" step="5"
                                               @bind="selection.Percentage" @bind:event="oninput" />
                                        <div style="display: flex; align-items: center; gap: 0.2rem; width: 75px;">
                                            <input type="number" class="form-control" style="padding: 0.2rem 0.4rem; font-size: 0.85rem; text-align: right;" min="0" max="100"
                                                   @bind="selection.Percentage" />
                                            <span style="font-size: 0.85rem;">%</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (_eventPlan.SelectedRecipes.Count > 0)
                    {
                        var totalPercent = TotalPercentage;
                        var is100 = totalPercent == 100m;
                        <div style="background-color: @(is100 ? "rgba(40, 167, 69, 0.1)" : "rgba(220, 53, 69, 0.1)"); border: 1px solid @(is100 ? "rgba(40, 167, 69, 0.3)" : "rgba(220, 53, 69, 0.3)"); border-radius: 6px; padding: 0.6rem 0.8rem; font-size: 0.85rem; color: @(is100 ? "#155724" : "#721c24"); display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                            <span>Verteilung gesamt:</span>
                            <strong>@totalPercent % @(is100 ? "✓" : "(Muss 100% ergeben)")</strong>
                        </div>
                    }
                }

                <button type="button" class="btn-primary" style="width: 100%; padding: 0.75rem;"
                        @onclick="CalculateEvent"
                        disabled="@(_eventPlan.SelectedRecipes.Count == 0 || _eventPlan.GuestCount <= 0 || TotalPercentage != 100m)">
                    🧮 Event jetzt kalkulieren
                </button>
            </div>
        </div>

        <!-- Rechte Spalte: Ergebnisse & Einkaufsliste -->
        <div>
            @if (_calculationResult == null)
            {
                <div class="card-panel text-center" style="padding: 4rem 2rem;">
                    <p style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem;">Noch keine Kalkulation vorhanden</p>
                    <p class="text-muted" style="margin-bottom: 0;">Fülle links die Parameter aus und klicke auf "Event jetzt kalkulieren".</p>
                </div>
            }
            else
            {
                <div class="card-panel">
                    <!-- Ergebnis-Header -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid rgba(0,0,0,0.08); padding-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
                        <h3 style="margin: 0; font-size: 1.2rem; font-weight: 600;">Ergebnis: @_calculationResult.EventTitle</h3>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <span class="badge badge-primary">@_calculationResult.TotalDrinksCount zahlende Drinks</span>
                            <button type="button" class="btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;" @onclick="ExportPdf">
                                📄 PDF Exportieren
                            </button>
                        </div>
                    </div>

                    <!-- Kennzahlen-Grid (4 Boxen) -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem;">
                        <div class="price-preview-box text-center" style="padding: 0.6rem;">
                            <span class="text-muted" style="display: block; font-size: 0.75rem; margin-bottom: 0.1rem;">Wareneinsatz (Gesamt)</span>
                            <strong style="color: #28a745; font-size: 1.1rem;">@_calculationResult.TotalMaterialCost.ToString("C2")</strong>
                        </div>
                        <div class="price-preview-box text-center" style="padding: 0.6rem;">
                            <span class="text-muted" style="display: block; font-size: 0.75rem; margin-bottom: 0.1rem;">Gesamtkosten (inkl. Fix/Pers)</span>
                            <strong style="color: #d9534f; font-size: 1.1rem;">@_calculationResult.TotalEventCosts.ToString("C2")</strong>
                        </div>
                        <div class="price-preview-box text-center" style="padding: 0.6rem;">
                            <span class="text-muted" style="display: block; font-size: 0.75rem; margin-bottom: 0.1rem;">Ziel-Umsatz (inkl. Gewinn)</span>
                            <strong style="color: var(--primary); font-size: 1.1rem;">@_calculationResult.TotalTargetRevenue.ToString("C2")</strong>
                        </div>
                        <div class="price-preview-box text-center" style="padding: 0.6rem;">
                            <span class="text-muted" style="display: block; font-size: 0.75rem; margin-bottom: 0.1rem;">Ø Verkaufspreis / Drink</span>
                            <strong style="color: #6f42c1; font-size: 1.1rem;">@_calculationResult.TargetSalesPricePerDrink.ToString("C2")</strong>
                        </div>
                    </div>

                    <!-- 1. Tabelle: Kalkulation pro Cocktail & Ziel-Verkaufspreis -->
                    <h4 style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.5rem;">🍹 Cocktail-Kalkulation & Verkaufspreise</h4>
                    <div style="overflow-x: auto; margin-bottom: 1.5rem;">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th>Cocktail</th>
                                    <th style="text-align: center;">Anteil</th>
                                    <th style="text-align: center;">Anzahl</th>
                                    <th style="text-align: right;">Real / Drink*</th>
                                    <th style="text-align: right; color: #6f42c1;">Empf. Verkaufspreis</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var calc in _calculationResult.RecipeCalculations)
                                {
                                    <tr>
                                        <td><strong>@calc.RecipeName</strong></td>
                                        <td style="text-align: center;">@calc.Percentage.ToString("0.##") %</td>
                                        <td style="text-align: center;">@calc.PayingDrinkCount (@calc.FreeDrinkCount) Stk.</td>
                                        <td style="text-align: right; color: #28a745;">@calc.RealCostPerDrink.ToString("C2")</td>
                                        <td style="text-align: right; font-weight: bold; color: #6f42c1;">@calc.TargetSalesPrice.ToString("C2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <span class="text-muted" style="font-size: 0.75rem; display: block; margin-top: 0.35rem;">
                            * Inkl. vollem Gebinde und anteiliger Berücksichtigung von Freigetränken. Empfohlener Verkaufspreis beinhaltet Wareneinsatz plus gewerblichen Fixkosten- und Gewinnaufschlag.
                        </span>
                    </div>

                    <!-- 2. Tabelle: Einkaufsliste -->
                    <h4 style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.5rem;">🛒 Automatische Einkaufsliste</h4>
                    <div style="overflow-x: auto;">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th>Zutat</th>
                                    <th>Bedarf (inkl. Puffer/Freidrinks)</th>
                                    <th style="text-align: center;">Kaufm. Gebinde</th>
                                    <th style="text-align: right;">Gesamtkosten</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _calculationResult.ShoppingList)
                                {
                                    <tr>
                                        <td><strong>@item.IngredientName</strong></td>
                                        <td>@item.TotalAmountNeeded.ToString("0.##") @GetUnitSuffix(item.Unit)</td>
                                        <td style="text-align: center;">
                                            <span class="badge badge-primary">
                                                @item.PackagesToBuy x (@item.PackageSize.ToString("0.##") @GetUnitSuffix(item.Unit))
                                            </span>
                                        </td>
                                        <td style="text-align: right;"><strong>@item.TotalCost.ToString("C2")</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (_showPersonnelModal)
{
    <div class="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;">
        <div class="card-panel" style="background: white; width: 90%; max-width: 650px; padding: 1.5rem; max-height: 80vh; overflow-y: auto;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid rgba(0,0,0,0.08); padding-bottom: 0.5rem;">
                <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600;">Personalkosten im Detail</h3>
                <button class="btn-secondary" style="padding: 0.2rem 0.5rem;" @onclick="ClosePersonnelModal">✕</button>
            </div>

            <!-- Spalten-Überschriften -->
            @if (_eventPlan.PersonnelCostItems.Any())
            {
                <div style="display: flex; gap: 0.5rem; padding: 0 0.5rem; margin-bottom: 0.3rem; font-size: 0.75rem; font-weight: 600; color: #6c757d;">
                    <div style="flex: 2;">Rolle / Position</div>
                    <div style="width: 70px; text-align: center;">Anzahl</div>
                    <div style="width: 80px; text-align: center;">Stunden</div>
                    <div style="width: 80px; text-align: center;">€ / Std.</div>
                    <div style="width: 38px;"></div>
                </div>
            }

            <!-- Liste der Positionen -->
            @foreach (var item in _eventPlan.PersonnelCostItems)
            {
                <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.75rem; background: rgba(0,0,0,0.02); padding: 0.5rem; border-radius: 6px;">
                    <input type="text" class="form-control" placeholder="z. B. Barkeeper" @bind="item.RoleName" style="flex: 2;" />
                    <input type="number" class="form-control" title="Anzahl Personen" @bind="item.Count" min="1" style="width: 70px; text-align: center;" />
                    <input type="number" class="form-control" title="Arbeitsstunden" @bind="item.Hours" min="0.5" step="0.5" style="width: 80px; text-align: center;" />
                    <input type="number" class="form-control" title="Stundensatz in Euro" @bind="item.HourlyRate" min="0" step="0.5" style="width: 80px; text-align: right;" />
                    <button class="btn-secondary" style="color: #dc3545; padding: 0.4rem 0.6rem;" title="Zeile löschen" @onclick="() => _eventPlan.PersonnelCostItems.Remove(item)">🗑️</button>
                </div>
            }

            <button class="btn-secondary" style="width: 100%; margin-bottom: 1.25rem;" @onclick="AddPersonnelItem">➕ Neue Position hinzufügen</button>

            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(0,0,0,0.08); padding-top: 0.75rem;">
                <strong style="font-size: 1rem;">Gesamtsumme Personal: @_eventPlan.PersonnelCostItems.Sum(x => x.TotalCost).ToString("C2")</strong>
                <button class="btn-primary" @onclick="SaveAndClosePersonnelModal">Übernehmen</button>
            </div>
        </div>
    </div>
}

@if (_showFixedModal)
{
    <div class="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000;">
        <div class="card-panel" style="background: white; width: 90%; max-width: 600px; padding: 1.5rem; max-height: 80vh; overflow-y: auto;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid rgba(0,0,0,0.08); padding-bottom: 0.5rem;">
                <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600;">Fixkosten im Detail</h3>
                <button class="btn-secondary" style="padding: 0.2rem 0.5rem;" @onclick="CloseFixedModal">✕</button>
            </div>

            <!-- Spalten-Überschriften -->
            @if (_eventPlan.FixedCostItems.Any())
            {
                <div style="display: flex; gap: 0.5rem; padding: 0 0.5rem; margin-bottom: 0.3rem; font-size: 0.75rem; font-weight: 600; color: #6c757d;">
                    <div style="flex: 2;">Beschreibung / Posten</div>
                    <div style="width: 120px; text-align: right;">Betrag (€)</div>
                    <div style="width: 38px;"></div>
                </div>
            }

            <!-- Liste der Positionen -->
            @foreach (var item in _eventPlan.FixedCostItems)
            {
                <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.75rem; background: rgba(0,0,0,0.02); padding: 0.5rem; border-radius: 6px;">
                    <input type="text" class="form-control" placeholder="z. B. Standmiete" @bind="item.Description" style="flex: 2;" />
                    <input type="number" class="form-control" placeholder="Betrag (€)" @bind="item.Amount" min="0" step="10" style="width: 120px; text-align: right;" />
                    <button class="btn-secondary" style="color: #dc3545; padding: 0.4rem 0.6rem;" title="Zeile löschen" @onclick="() => _eventPlan.FixedCostItems.Remove(item)">🗑️</button>
                </div>
            }

            <button class="btn-secondary" style="width: 100%; margin-bottom: 1.25rem;" @onclick="AddFixedItem">➕ Neue Position hinzufügen</button>

            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(0,0,0,0.08); padding-top: 0.75rem;">
                <strong style="font-size: 1rem;">Gesamtsumme Fixkosten: @_eventPlan.FixedCostItems.Sum(x => x.Amount).ToString("C2")</strong>
                <button class="btn-primary" @onclick="SaveAndCloseFixedModal">Übernehmen</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _showPersonnelModal = false;
    private bool _showFixedModal = false;
    private EventPlan _eventPlan = CreateEmptyEventPlan();
    private List<EventPlan> _savedEventPlans = new();
    private List<Recipe> _availableRecipes = new();
    private CalculationResult? _calculationResult;

    private decimal TotalPercentage => _eventPlan.SelectedRecipes.Sum(r => r.Percentage);

    protected override async Task OnInitializedAsync()
    {
        _availableRecipes = await RecipeRepository.GetAllRecipesAsync();
        await LoadSavedEventPlansAsync();
    }

    private async Task LoadSavedEventPlansAsync()
    {
        _savedEventPlans = await EventPlanRepository.GetAllEventPlansAsync();
    }

    private static EventPlan CreateEmptyEventPlan() => new()
    {
        Id = Guid.NewGuid(),
        Title = "Neues Event",
        GuestCount = 30,
        AverageDrinksPerGuest = 3,
        WasteBufferPercent = 10m,
        FixedCosts = 150m,
        PersonnelCosts = 300m,
        TargetProfit = 500m,
        FreeDrinksCount = 10,
        SelectedRecipes = new List<EventRecipe>()
    };

    private void CreateNewEvent()
    {
        _eventPlan = CreateEmptyEventPlan();
        _calculationResult = null;
    }

    private async Task OnEventSelected(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out Guid id) && id != Guid.Empty)
        {
            var loaded = await EventPlanRepository.GetEventPlanByIdAsync(id);
            if (loaded != null)
            {
                _eventPlan = loaded;
                _calculationResult = null;
            }
        }
        else
        {
            CreateNewEvent();
        }
    }

    private async Task SaveCurrentEvent()
    {
        await EventPlanRepository.SaveEventPlanAsync(_eventPlan);
        await LoadSavedEventPlansAsync();
    }

    private async Task DeleteCurrentEvent()
    {
        if (_eventPlan.Id != Guid.Empty)
        {
            await EventPlanRepository.DeleteEventPlanAsync(_eventPlan.Id);
            await LoadSavedEventPlansAsync();
            CreateNewEvent();
        }
    }

    private void ToggleRecipeSelection(Recipe recipe)
    {
        var existing = _eventPlan.SelectedRecipes.FirstOrDefault(r => r.RecipeId == recipe.Id);
        if (existing != null)
        {
            _eventPlan.SelectedRecipes.Remove(existing);
        }
        else
        {
            _eventPlan.SelectedRecipes.Add(new EventRecipe
            {
                EventPlanId = _eventPlan.Id,
                RecipeId = recipe.Id,
                Recipe = recipe,
                Percentage = 0m
            });
            DistributeEvenly();
        }
    }

    private void DistributeEvenly()
    {
        int count = _eventPlan.SelectedRecipes.Count;
        if (count == 0) return;

        decimal evenShare = Math.Floor(100m / count);
        decimal remainder = 100m - (evenShare * count);

        for (int i = 0; i < count; i++)
        {
            _eventPlan.SelectedRecipes[i].Percentage = evenShare + (i == 0 ? remainder : 0m);
        }
    }

    private void CalculateEvent()
    {
        _calculationResult = CalculationService.Calculate(_eventPlan);
    }

    private async Task ExportPdf()
    {
        if (_calculationResult == null)
            return;

        var pdfBytes = CateringCalculator.Infrastructure.Services.ShoppingListPdfGenerator.GeneratePdf(_calculationResult);
        var fileName = $"Einkaufsliste_{_calculationResult.EventTitle.Replace(" ", "_")}_{DateTime.Now:yyyyMMdd_HHmm}.pdf";

        await FileSaveService.SaveAndOpenFileAsync(fileName, pdfBytes);
    }

    private static string GetUnitSuffix(IngredientUnit unit) => unit switch
    {
        IngredientUnit.Piece => "Stk.",
        IngredientUnit.Gram => "g",
        IngredientUnit.Milliliter => "ml",
        _ => "ml"
    };

