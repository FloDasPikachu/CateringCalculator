@page "/event-planner"
@using CateringCalculator.Core.Interfaces
@using CateringCalculator.Core.Models
@using CateringCalculator.Core.Services
@inject IRecipeRepository RecipeRepository
@inject CalculationService CalculationService
@inject CateringCalculator.UI.Services.FileSaveService FileSaveService

<PageTitle>Event Kalkulator - CateringCalculator</PageTitle>

<h1>Event-Planung & Kalkulation</h1>
<p>Berechne die benötigten Zutaten, Flaschenzahlen und Materialkosten für deine Veranstaltung.</p>

<div class="row">
    <!-- Linke Spalte: Event-Parameter & Rezeptauswahl -->
    <div class="col-md-5 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">1. Event-Details</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Veranstaltungsname</label>
                    <input type="text" class="form-control" @bind="_eventPlan.Title" placeholder="z. B. Sommerfest 2026" />
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label class="form-label font-weight-bold">Anzahl Gäste</label>
                        <input type="number" class="form-control" @bind="_eventPlan.GuestCount" min="1" />
                    </div>
                    <div class="col-6">
                        <label class="form-label font-weight-bold">Drinks / Gast</label>
                        <input type="number" class="form-control" @bind="_eventPlan.AverageDrinksPerGuest" min="1" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label font-weight-bold">Puffer für Schwund (%)</label>
                    <input type="number" class="form-control" @bind="_eventPlan.WasteBufferPercent" min="0" max="50" />
                    <small class="text-muted">Aufschlag für Verschnitt, Kleckern & Gratis-Drinks.</small>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
                    <h5 class="mb-0">2. Cocktails auswählen</h5>
                    @if (_eventPlan.SelectedRecipes.Count > 0) {
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DistributeEvenly">
                            ⚖️ Gleichmäßig aufteilen
                        </button>
                    }
                </div>

                @if (_availableRecipes.Count == 0) {
                    <div class="alert alert-warning small">
                        Keine Rezepte vorhanden. Bitte erst unter "Rezepte" Cocktails anlegen!
                    </div>
                } else {
                    <div class="list-group mb-3" style="max-height: 300px; overflow-y: auto;">
                        @foreach (var recipe in _availableRecipes) {
                            var selection = _eventPlan.SelectedRecipes.FirstOrDefault(r => r.RecipeId == recipe.Id);
                            var isSelected = selection != null;

                            <div class="list-group-item @(isSelected ? "border-primary bg-light" : "")">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@isSelected"
                                               id="chk-@recipe.Id"
                                               @onchange="() => ToggleRecipeSelection(recipe)" />
                                        <label class="form-check-label font-weight-bold" for="chk-@recipe.Id">
                                            @recipe.Name
                                        </label>
                                    </div>
                                    <span class="badge bg-secondary">
                                        @recipe.TotalCostPerDrink.ToString("C2")
                                    </span>
                                </div>

                                @if (isSelected && selection != null) {
                                    <div class="d-flex align-items-center gap-2 mt-2 pt-2 border-top">
                                        <small class="text-nowrap">Anteil:</small>
    
                                        <input type="range" class="form-range flex-grow-1" style="min-width: 0;" min="0" max="100" step="5"
                                               @bind="selection.Percentage" @bind:event="oninput" />
           
                                        <div class="input-group input-group-sm flex-shrink-0" style="width: 90px;">
                                            <input type="number" class="form-control text-end px-1" min="0" max="100"
                                                   @bind="selection.Percentage" />
                                            <span class="input-group-text px-1">%</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (_eventPlan.SelectedRecipes.Count > 0) {
                        var totalPercent = TotalPercentage;
                        <div class="alert @(totalPercent == 100m ? "alert-success" : "alert-danger") p-2 small d-flex justify-content-between align-items-center mb-3">
                            <span>Gesamtsumme Verteilung:</span>
                            <strong>@totalPercent % @(totalPercent != 100m ? "(Muss 100% ergeben)" : "✓")</strong>
                        </div>
                    }
                }

                <button class="btn btn-success w-100 mt-2"
                        @onclick="CalculateEvent"
                        disabled="@(_eventPlan.SelectedRecipes.Count == 0 || _eventPlan.GuestCount <= 0 || TotalPercentage != 100m)">
                    🧮 Event jetzt berechnen
                </button>
            </div>
        </div>
    </div>

    <!-- Rechte Spalte: Ergebnisse & Einkaufsliste -->
    <div class="col-md-7">
        @if (_calculationResult == null) {
            <div class="card border-dashed p-5 text-center text-muted">
                <h4>Noch keine Kalkulation vorhanden</h4>
                <p>Wähle links Gästezahl und Rezepte aus und klicke auf "Event jetzt berechnen".</p>
            </div>
        } else {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Ergebnis: @_calculationResult.EventTitle</h5>
                    <div>
                        <span class="badge bg-info text-dark me-2">@_calculationResult.TotalDrinksCount Drinks gesamt</span>
                        <button class="btn btn-sm btn-success" @onclick="ExportPdf">
                            📄 PDF Exportieren
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Kennzahlen-Kacheln -->
                    <div class="row text-center mb-4">
                        <div class="col-4">
                            <div class="p-2 border rounded bg-light">
                                <small class="text-muted d-block">Wareneinsatz</small>
                                <strong class="h5 text-success">@_calculationResult.TotalMaterialCost.ToString("C2")</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded bg-light">
                                <small class="text-muted d-block">Kosten / Drink</small>
                                <strong class="h5">@_calculationResult.CostPerDrink.ToString("C2")</strong>
                            </div>
                        </div>
                    </div>

                    <h6 class="mt-4">🍹 Kalkulation pro Cocktail</h6>
                        <div class="table-responsive mb-4">
                            <table class="table table-hover table-striped align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Cocktail</th>
                                        <th class="text-center">Anteil</th>
                                        <th class="text-center">Anzahl</th>
                                        <th class="text-end text-muted">Soll / Drink</th>
                                        <th class="text-end fw-bold">Real / Drink*</th>
                                        <th class="text-end">Gesamtkosten</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var calc in _calculationResult.RecipeCalculations)
                                    {
                                        <tr>
                                            <td><strong>@calc.RecipeName</strong></td>
                                            <td class="text-center">@calc.Percentage.ToString("0.##") %</td>
                                            <td class="text-center">@calc.TargetDrinkCount Stk.</td>
                                            <td class="text-end text-muted">@calc.TheoreticalCostPerDrink.ToString("C2")</td>
                                            <td class="text-end fw-bold text-success">@calc.RealCostPerDrink.ToString("C2")</td>
                                            <td class="text-end">@calc.RealCostTotal.ToString("C2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <small class="text-muted d-block ms-1">
                                * <strong>Real / Drink:</strong> Anteilsmäßige tatsächliche Einkaufskosten inklusive ganzer Flaschen/Gebinde aus der Einkaufsliste.
                            </small>
                        </div>

                    <h6>🛒 Automatische Einkaufsliste</h6>
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Zutat</th>
                                    <th>Gesamtbedarf</th>
                                    <th class="text-center">Kaufm. Gebinde</th>
                                    <th class="text-end">Gesamtkosten</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _calculationResult.ShoppingList) {
                                    <tr>
                                        <td><strong>@item.IngredientName</strong></td>
                                        <td>@item.TotalAmountNeeded.ToString("0.##") @GetUnitSuffix(item.Unit)</td>
                                        <td class="text-center">
                                            <span class="badge bg-primary fs-6">
                                                @item.PackagesToBuy x (@item.PackageSize.ToString("0.##") @GetUnitSuffix(item.Unit))
                                            </span>
                                        </td>
                                        <td class="text-end">@item.TotalCost.ToString("C2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private EventPlan _eventPlan = new() { Title = "Neues Event", GuestCount = 30, AverageDrinksPerGuest = 3 };
    private List<Recipe> _availableRecipes = new();
    private CalculationResult? _calculationResult;

    private decimal TotalPercentage => _eventPlan.SelectedRecipes.Sum(r => r.Percentage);

    protected override async Task OnInitializedAsync() {
        _availableRecipes = await RecipeRepository.GetAllRecipesAsync();
    }

    private void ToggleRecipeSelection(Recipe recipe) {
        var existing = _eventPlan.SelectedRecipes.FirstOrDefault(r => r.RecipeId == recipe.Id);
        if (existing != null) {
            _eventPlan.SelectedRecipes.Remove(existing);
        } else {
            _eventPlan.SelectedRecipes.Add(new EventRecipe {
                EventPlanId = _eventPlan.Id,
                RecipeId = recipe.Id,
                Recipe = recipe,
                Percentage = 0m
            });
            DistributeEvenly();
        }
    }

    private void DistributeEvenly() {
        int count = _eventPlan.SelectedRecipes.Count;
        if (count == 0) return;

        decimal evenShare = Math.Floor(100m / count);
        decimal remainder = 100m - (evenShare * count);

        for (int i = 0; i < count; i++) {
            _eventPlan.SelectedRecipes[i].Percentage = evenShare + (i == 0 ? remainder : 0m);
        }
    }

    private void CalculateEvent() {
        _calculationResult = CalculationService.Calculate(_eventPlan);
    }

    private async Task ExportPdf() {
        if (_calculationResult == null)
            return;

        var pdfBytes = CateringCalculator.Infrastructure.Services.ShoppingListPdfGenerator.GeneratePdf(_calculationResult);
        var fileName = $"Einkaufsliste_{_calculationResult.EventTitle.Replace(" ", "_")}_{DateTime.Now:yyyyMMdd_HHmm}.pdf";

        await FileSaveService.SaveAndOpenFileAsync(fileName, pdfBytes);
    }

    private static string GetUnitSuffix(CateringCalculator.Core.Enums.IngredientUnit unit) => unit switch {
        CateringCalculator.Core.Enums.IngredientUnit.Piece => "Stk.",
        CateringCalculator.Core.Enums.IngredientUnit.Gram => "g",
        CateringCalculator.Core.Enums.IngredientUnit.Milliliter => "ml",
        _ => "ml"
    };
}