@page "/ingredients"
@using CateringCalculator.Core.Interfaces
@using CateringCalculator.Core.Models
@using CateringCalculator.Core.Enums
@inject IRecipeRepository RecipeRepository

<PageTitle>Zutatenübersicht</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Zutatenverwaltung</h3>
        <button class="btn btn-primary" @onclick="OpenAddModal">
            <i class="bi bi-plus-lg"></i> Neue Zutat anlegen
        </button>
    </div>

    @if (_ingredients == null) {
        <p><em>Zutaten werden geladen...</em></p>
    } else if (!_ingredients.Any()) {
        <div class="alert alert-info">
            Noch keine Zutaten vorhanden. Lege jetzt die erste Zutat an!
        </div>
    } else {
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Einheit</th>
                    <th>Gebindegröße</th>
                    <th>Gebindepreis (€)</th>
                    <th>Preis / Einheit (€)</th>
                    <th style="width: 150px;" class="text-end">Aktionen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ingredient in _ingredients) {
                    <tr>
                        <td><strong>@ingredient.Name</strong></td>
                        <td><span class="badge bg-secondary">@ingredient.Unit</span></td>
                        <td>@ingredient.PackageSize.ToString("N2") @ingredient.Unit</td>
                        <td>@ingredient.PackagePrice.ToString("C2")</td>
                        <td><strong>@ingredient.PricePerUnit.ToString("C4")</strong> / @ingredient.Unit</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(ingredient)">
                                Bearbeiten
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@* Modal zum Erstellen / Bearbeiten *@
@if (_showModal) {
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(_editingIngredient.Id == Guid.Empty ? "Neue Zutat anlegen" : "Zutat bearbeiten")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="_editingIngredient" OnValidSubmit="SaveIngredientAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Name der Zutat</label>
                            <InputText class="form-control" @bind-Value="_editingIngredient.Name" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Einheit</label>
                            <InputSelect class="form-select" @bind-Value="_editingIngredient.Unit">
                                @foreach (var unit in Enum.GetValues<IngredientUnit>()) {
                                    <option value="@unit">@unit</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Packungsgröße (@_editingIngredient.Unit)</label>
                                <InputNumber class="form-control" @bind-Value="_editingIngredient.PackageSize" step="0.01" min="0.01" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Packungspreis (€)</label>
                                <InputNumber class="form-control" @bind-Value="_editingIngredient.PackagePrice" step="0.01" min="0" required />
                            </div>
                        </div>

                        <div class="alert alert-light border mt-2">
                            <small class="text-muted d-block">Errechneter Preis pro Einheit:</small>
                            <strong>@_editingIngredient.PricePerUnit.ToString("C4") / @_editingIngredient.Unit</strong>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Abbrechen</button>
                        <button type="submit" class="btn btn-success">Speichern</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Ingredient>? _ingredients;
    private Ingredient _editingIngredient = new();
    private bool _showModal = false;

    protected override async Task OnInitializedAsync() {
        await LoadIngredientsAsync();
    }

    private async Task LoadIngredientsAsync() {
        _ingredients = await RecipeRepository.GetAllIngredientsAsync();
    }

    private void OpenAddModal() {
        _editingIngredient = new Ingredient {
            Id = Guid.Empty,
            Name = "",
            Unit = IngredientUnit.Milliliter,
            PackageSize = 1000m,
            PackagePrice = 0m
        };
        _showModal = true;
    }

    private void OpenEditModal(Ingredient ingredient) {
        _editingIngredient = new Ingredient {
            Id = ingredient.Id,
            Name = ingredient.Name,
            Unit = ingredient.Unit,
            PackageSize = ingredient.PackageSize,
            PackagePrice = ingredient.PackagePrice
        };
        _showModal = true;
    }

    private void CloseModal() {
        _showModal = false;
    }

    private async Task SaveIngredientAsync() {
        if (_editingIngredient.Id == Guid.Empty) {
            _editingIngredient.Id = Guid.NewGuid();
            await RecipeRepository.AddIngredientAsync(_editingIngredient);
        } else {
            await RecipeRepository.UpdateIngredientAsync(_editingIngredient);
        }

        _showModal = false;
        await LoadIngredientsAsync();
    }
}