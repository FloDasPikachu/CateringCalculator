<div>
    @if (CalculationResult == null) {
        <div class="card-panel text-center event-empty-panel">
            <p class="event-empty-title">@AppResources.Event_NoCalculationYet</p>
            <p class="text-muted mb-0">@AppResources.Event_NoCalculationHint</p>
        </div>
    } else {
        <div class="card-panel">
            <!-- Header -->
            <div class="event-result-header">
                <h3 class="event-result-title">@AppResources.Event_ResultPrefix @CalculationResult.EventTitle</h3>
                <div class="event-result-actions">
                    <span class="badge badge-primary">@CalculationResult.TotalDrinksCount @AppResources.Event_PayingDrinksCount</span>
                    <button type="button" class="btn-secondary event-action-btn" @onclick="ExportPdf">
                        📄 @AppResources.Event_ExportPdf
                    </button>
                    <button type="button" class="btn-secondary event-action-btn" @onclick="DeductStock">
                        📦 @AppResources.Event_DeductStock
                    </button>
                </div>
            </div>

            <!-- Key Performance Indicator Grid -->
            <div class="event-kpi-grid">
                <div class="price-preview-box text-center event-kpi-box">
                    <span class="text-muted event-kpi-label">@AppResources.Event_MaterialCostTotal</span>
                    <strong class="event-kpi-value text-success-custom">@CalculationResult.TotalMaterialCost.ToString("N2") €</strong>
                </div>
                <div class="price-preview-box text-center event-kpi-box">
                    <span class="text-muted event-kpi-label">@AppResources.Event_TotalEventCosts</span>
                    <strong class="event-kpi-value text-danger-custom">@CalculationResult.TotalEventCosts.ToString("N2") €</strong>
                </div>
                <div class="price-preview-box text-center event-kpi-box">
                    <span class="text-muted event-kpi-label">@AppResources.Event_TargetRevenue</span>
                    <strong class="event-kpi-value text-primary-custom">@CalculationResult.TotalTargetRevenue.ToString("N2") €</strong>
                </div>
                <div class="price-preview-box text-center event-kpi-box">
                    <span class="text-muted event-kpi-label">@AppResources.Event_AvgSalesPrice</span>
                    <strong class="event-kpi-value text-purple-custom">@CalculationResult.TargetSalesPricePerDrink.ToString("N2") €</strong>
                </div>
            </div>

            <!-- 1. Table: Calculation per Recipe -->
            <h4 class="event-section-title">🍹 @AppResources.Event_CocktailCalcTitle</h4>
            <div class="event-table-wrapper-recipe">
                <div class="table-responsive stack-on-mobile">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>@AppResources.Event_TableCocktail</th>
                                <th class="text-center">@AppResources.Event_TableShare</th>
                                <th class="text-center">@AppResources.Event_TableCount</th>
                                <th class="text-right">@AppResources.Event_TableRealPerDrink</th>
                                <th class="text-right text-purple-custom">@AppResources.Event_TableRecommendedPrice</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var calc in CalculationResult.RecipeCalculations) {
                                <tr>
                                    <td><strong>@calc.RecipeName</strong></td>
                                    <td data-label="@AppResources.Event_TableShare" class="text-center">@calc.Percentage.ToString("0.##") %</td>
                                    <td data-label="@AppResources.Event_TableCount" class="text-center">@calc.PayingDrinkCount (@calc.FreeDrinkCount) Stk.</td>
                                    <td data-label="@AppResources.Event_TableRealPerDrink" class="text-right text-success-custom">@calc.RealCostPerDrink.ToString("N2") €</td>
                                    <td data-label="@AppResources.Event_TableRecommendedPrice" class="text-right fw-bold text-purple-custom">@calc.TargetSalesPrice.ToString("N2") €</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <span class="text-muted event-disclaimer">
                    @AppResources.Event_CalcDisclaimer
                </span>
            </div>

            <!-- 2. Table: Shoppinglist -->
            <h4 class="event-section-title">🛒 @AppResources.Event_ShoppingListTitle</h4>
            <div class="overflow-x-auto">
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>@AppResources.Event_TableIngredient</th>
                                <th class="text-right">@AppResources.Event_TableNeeded</th>
                                <th class="text-right">@AppResources.Event_TableStock</th>
                                <th class="text-center">@AppResources.Event_TablePackage</th>
                                <th class="text-center">@AppResources.Event_Remaining</th>
                                <th class="text-right">@AppResources.Event_TableTotalCost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in CalculationResult.ShoppingList) {
                                <tr>
                                    <td><strong>@item.IngredientName</strong></td>
                                    <td class="text-right">@item.TotalAmountNeeded.ToString("0.##") @GetUnitSuffix(item.Unit)</td>
                                    <td class="text-right text-muted-stock">@item.EffectiveStockDisplay.ToString("0.##") @GetUnitSuffix(item.Unit)</td>
                                    <td class="text-center">
                                        @if (item.PackagesToBuy > 0) {
                                            <span class="badge badge-primary">
                                                @item.PackagesToBuy x (@item.PackageSize.ToString("0.##") @GetUnitSuffix(item.Unit))
                                            </span>
                                        } else {
                                            <span class="event-badge-success">✓ Komplett auf Lager</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.RemainingAmount > 0) {
                                            <span class="text-muted event-font-sm">
                                                @item.RemainingAmount.ToString("0.##") @GetUnitSuffix(item.Unit)
                                            </span>
                                        } else {
                                            <span class="text-danger-custom event-font-sm">0 @GetUnitSuffix(item.Unit)</span>
                                        }
                                    </td>
                                    <td class="text-right"><strong>@item.TotalCost.ToString("N2") €</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>