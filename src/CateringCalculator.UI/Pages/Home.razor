@page "/"
@using CateringCalculator.Resources.Internationalization
@inherits CateringCalculator.UI.Shared.LocalizedComponentBase

<PageTitle>@AppResources.Home_Title - Catering Calculator</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">@AppResources.Home_Title</h1>
            <p class="text-muted" style="margin-bottom: 0;">@AppResources.Home_Subtitle</p>
        </div>
    </div>

    <div class="card-panel">
        <p style="margin: 0 0 1rem 0;">@AppResources.Home_Intro</p>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div>
                <h3 style="font-size: 1.05rem; margin-top: 0;">@AppResources.Home_UsageTitle</h3>
                <ol style="padding-left: 1.2rem; margin-top: 0.5rem; color: var(--text-muted);">
                    <li style="margin-bottom: 0.5rem;">@AppResources.Home_Usage_Step1</li>
                    <li style="margin-bottom: 0.5rem;">@AppResources.Home_Usage_Step2</li>
                    <li style="margin-bottom: 0.5rem;">@AppResources.Home_Usage_Step3</li>
                </ol>
                <p class="text-muted" style="margin-top: 0.5rem;">@AppResources.Home_Note</p>
            </div>

            <div>
                <h3 style="font-size: 1.05rem; margin-top: 0;">🔎 @AppResources.Nav_Recipes</h3>
                <p class="text-muted" style="margin-top: 0.25rem;">@AppResources.Recipes_Subtitle</p>

                <h3 style="font-size: 1.05rem; margin-top: 1rem;">📦 @AppResources.Nav_Ingredients</h3>
                <p class="text-muted" style="margin-top: 0.25rem;">@AppResources.Ingredients_Subtitle</p>

                <h3 style="font-size: 1.05rem; margin-top: 1rem;">📅 @AppResources.Nav_EventPlanner</h3>
                <p class="text-muted" style="margin-top: 0.25rem;">@AppResources.Event_Subtitle</p>
            </div>
        </div>
    </div>
</div>
