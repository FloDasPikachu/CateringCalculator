@page "/ingredients"
@using CateringCalculator.Core.Interfaces
@using CateringCalculator.UI.Resources.Internationalization
@inject IRecipeRepository RecipeRepository

<PageTitle>@AppResources.Ingredients_Title</PageTitle>

<div class="page-container">
    <div class="page-header" @ref="pageHeaderRef">
        <div>
            <h1 class="page-title">@AppResources.Ingredients_Title</h1>
            <p class="text-muted" style="margin-bottom: 0;">@AppResources.Ingredients_Subtitle</p>
        </div>
        <button class="btn-primary" @onclick="OpenAddModal">
            <span>➕</span> @AppResources.Ingredients_New
        </button>
    </div>

    @if (_ingredients == null) {
        <div class="card-panel text-center" style="padding: 3rem;">
            <p class="text-muted" style="margin: 0;"><em>@AppResources.Ingredients_Loading</em></p>
        </div>
    } else if (!_ingredients.Any()) {
        <div class="card-panel text-center" style="padding: 3rem;">
            <p style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem;">@AppResources.Ingredients_EmptyTitle</p>
            <p class="text-muted" style="margin-bottom: 1.5rem;">@AppResources.Ingredients_EmptyDesc</p>
            <button class="btn-primary" @onclick="OpenAddModal">@AppResources.Ingredients_New</button>
        </div>
    } else {
        <!-- 1. Normale Tabelle für Desktop & Tablets -->
        <div class="card-panel" style="padding: 0; overflow-x: auto;">
            <div class="table-responsive hide-on-mobile">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>@AppResources.Ingredients_Name</th>
                            <th>@AppResources.Ingredients_Unit</th>
                            <th>@AppResources.Ingredients_PackageSize</th>
                            <th>@AppResources.Ingredients_PackagePrice</th>
                            <th>@AppResources.Ingredients_PricePerUnit</th>
                            <th style="width: 180px; text-align: right;">@AppResources.Ingredients_Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ingredient in _ingredients) {
                            <tr>
                                <td><strong>@ingredient.Name</strong></td>
                                <td><span class="badge badge-primary">@ingredient.Unit</span></td>
                                <td>@ingredient.PackageSize.ToString("N2") @ingredient.Unit</td>
                                <td>@ingredient.PackagePrice.ToString("N2") €</td>
                                <td><strong>@ingredient.PricePerUnit.ToString("N4") €</strong> / @ingredient.Unit</td>
                                <td style="text-align: right; display: flex; gap: 0.5rem; justify-content: flex-end;">
                                    <button class="btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;" @onclick="() => OpenEditModal(ingredient)">
                                        @AppResources.Button_Edit
                                    </button>
                                    <button class="btn-secondary" style="padding: 0.35rem 0.5rem; font-size: 0.85rem; color: #dc3545;" @onclick="() => ConfirmDeleteIngredient(ingredient)" title="@AppResources.Button_Delete">
                                        🗑️
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- 2. Mobile Karten-Ansicht für Smartphones -->
            <div class="ingredients-card-list" style="padding: 1rem;">
                @foreach (var ingredient in _ingredients) {
                    <div class="ingredient-card">
                        <div class="ingredient-card-header">
                            <span>@ingredient.Name</span>
                            <span class="badge badge-primary">@ingredient.Unit</span>
                        </div>
                        <div class="ingredient-card-body">
                            <span class="label">@AppResources.Ingredients_PackageSize:</span>
                            <span class="value">@ingredient.PackageSize.ToString("N2") @ingredient.Unit</span>
                            
                            <span class="label">@AppResources.Ingredients_PackagePrice:</span>
                            <span class="value">@ingredient.PackagePrice.ToString("N2") €</span>
                            
                            <span class="label">@AppResources.Ingredients_PricePerUnit:</span>
                            <span class="value">@ingredient.PricePerUnit.ToString("N4") € / @ingredient.Unit</span>
                        </div>
                        <div class="ingredient-card-actions">
                            <button class="btn-secondary" @onclick="() => OpenEditModal(ingredient)">
                                ✏️ @AppResources.Button_Edit
                            </button>
                            <button class="btn-danger" @onclick="() => ConfirmDeleteIngredient(ingredient)">
                                🗑️ @AppResources.Button_Delete
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<IngredientModal IsVisible="_showModal"
                 Ingredient="_editingIngredient"
                 OnSave="HandleSaveIngredientAsync"
                 OnClose="CloseModal" />

<DeleteConfirmationModal IsVisible="_showDeleteConfirmation"
                         Title="@AppResources.DeleteModal_IngredientTitle"
                         Message="@string.Format(AppResources.DeleteModal_IngredientMessage, _ingredientToDelete?.Name)"
                         OnConfirm="ExecuteDeleteIngredientAsync"
                         OnCancel="CancelDelete" />

<InfoModal IsVisible="_showInfoModal"
           Title="@AppResources.InfoModal_Title"
           Message="_infoMessage"
           OnClose="CloseInfoModal" />