@page "/recipes"
@using CateringCalculator.Core.Interfaces
@using CateringCalculator.UI.Resources.Internationalization
@inject IRecipeRepository RecipeRepository

<PageTitle>@AppResources.Recipes_Title - Catering Calculator</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">@AppResources.Recipes_Title</h1>
            <p class="text-muted" style="margin-bottom: 0;">@AppResources.Recipes_Subtitle</p>
        </div>
        <button class="btn-primary" @onclick="OpenCreateDialog">
            <span>➕</span> @AppResources.Recipes_New
        </button>
    </div>

    <!-- Suchfeld -->
    <div class="card-panel" style="margin-bottom: 1.5rem; padding: 1rem;">
        <div style="position: relative; margin-bottom: @(string.IsNullOrWhiteSpace(_selectedGroupFilter) ? "0" : "0.75rem")">
            <input type="text" class="form-control" @bind="_searchTerm" @bind:event="oninput" placeholder="@AppResources.Search_Placeholder" style="padding-left: 2.5rem; padding-right: 2.5rem;" />
            <span style="position: absolute; left: 0.8rem; top: 50%; transform: translateY(-50%); font-size: 1.1rem; color: var(--text-muted);">🔍</span>

            @if (!string.IsNullOrWhiteSpace(_searchTerm)) {
                <button type="button" @onclick="ClearSearch" style="position: absolute; right: 0.8rem; top: 50%; transform: translateY(-50%); background: none; border: none; font-size: 1.1rem; color: var(--text-muted); cursor: pointer; padding: 0; line-height: 1;" title="Suche leeren">✕</button>
            }
        </div>

        <!-- Aktiver Gruppenfilter Indikator -->
        @if (!string.IsNullOrWhiteSpace(_selectedGroupFilter)) {
            <div style="display: flex; align-items: center; gap: 0.5rem; padding-top: 0.5rem; border-top: 1px solid rgba(0,0,0,0.05);">
                <span class="text-muted" style="font-size: 0.85rem;">Aktive Gruppe:</span>
                <span style="background-color: var(--primary); color: white; font-size: 0.8rem; padding: 0.2rem 0.6rem; border-radius: 12px; font-weight: 500; display: inline-flex; align-items: center; gap: 0.4rem;">
                    #@_selectedGroupFilter
                    <button type="button" @onclick="ClearGroupFilter" style="background: none; border: none; color: white; cursor: pointer; padding: 0; font-size: 0.9rem; line-height: 1;" title="Filter aufheben">✕</button>
                </span>
            </div>
        }
    </div>

    @if (_isLoading) {
        <div class="card-panel text-center" style="padding: 3rem;">
            <p class="text-muted" style="margin: 0;"><em>@AppResources.Recipes_Loading</em></p>
        </div>
    } else if (_recipes.Count == 0) {
        <div class="card-panel text-center" style="padding: 3rem;">
            <p style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem;">@AppResources.Recipes_EmptyTitle</p>
            <p class="text-muted" style="margin-bottom: 1.5rem;">@AppResources.Recipes_EmptyDesc</p>
            <button class="btn-primary" @onclick="OpenCreateDialog">@AppResources.Recipes_FirstNew</button>
        </div>
    } else {
        var evaluatedRecipes = EvaluatedRecipes.ToList();
        var topResults = evaluatedRecipes.Where(x => x.Score > 0).OrderByDescending(x => x.Score).ToList();
        var otherResults = evaluatedRecipes.Where(x => x.Score == 0).ToList();

        <!-- Bereich 1: Passende Treffer -->
        @if (!string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_selectedGroupFilter)) {
            <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--primary);">
                ⭐ @AppResources.Search_TopResults (@topResults.Count)
            </h3>
        }

        @if (topResults.Any() || (string.IsNullOrWhiteSpace(_searchTerm) && string.IsNullOrWhiteSpace(_selectedGroupFilter))) {
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
                @foreach (var item in ((string.IsNullOrWhiteSpace(_searchTerm) && string.IsNullOrWhiteSpace(_selectedGroupFilter)) ? evaluatedRecipes.Select(x => (x.Recipe, x.Score)) : topResults)) {
                    <RecipeCard Recipe="item.Recipe"
                                OnEdit="EditRecipe"
                                OnDelete="ConfirmDeleteRecipe"
                                OnGroupClick="FilterByGroup" />
                }
            </div>
        }

        <!-- Bereich 2: Weitere Cocktails (Rest) -->
        @if ((!string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_selectedGroupFilter)) && otherResults.Any()) {
            <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-muted);">
                📌 @AppResources.Search_OtherResults (@otherResults.Count)
            </h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; opacity: 0.85;">
                @foreach (var item in otherResults) {
                    <RecipeCard Recipe="item.Recipe"
                                OnEdit="EditRecipe"
                                OnDelete="ConfirmDeleteRecipe"
                                OnGroupClick="FilterByGroup" />
                }
            </div>
        }
    }
</div>

<RecipeModal IsVisible="_showForm"
             Recipe="_editingRecipe"
             AvailableIngredients="_availableIngredients"
             AvailableGroups="AllExistingGroups"
             IsEditing="_isEditing"
             IsSaving="_isSaving"
             OnSave="SaveRecipeAsync"
             OnClose="CloseForm"
             OnIngredientAdded="HandleIngredientAddedAsync" />

<DeleteConfirmationModal IsVisible="_showDeleteConfirmation"
                         Title="@AppResources.DeleteModal_RecipeTitle"
                         Message="@string.Format(AppResources.DeleteModal_RecipeMessage, _recipeToDelete?.Name)"
                         OnConfirm="ExecuteDeleteRecipeAsync"
                         OnCancel="CancelDelete" />