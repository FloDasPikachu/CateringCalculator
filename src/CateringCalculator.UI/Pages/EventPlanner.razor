@page "/event-planner"
@using CateringCalculator.Core.Interfaces
@using CateringCalculator.Core.Services
@using CateringCalculator.UI.Resources.Internationalization
@inject IRecipeRepository RecipeRepository
@inject IEventPlanRepository EventPlanRepository
@inject CalculationService CalculationService
@inject CateringCalculator.UI.Services.FileSaveService FileSaveService

<PageTitle>@AppResources.Event_Title - Catering Calculator</PageTitle>

<div class="page-container">
    <!-- Header-Bereich -->
    <div class="page-header">
        <div>
            <h1 class="page-title">@AppResources.Event_Title</h1>
            <p class="text-muted" style="margin-bottom: 0;">@AppResources.Event_Subtitle</p>
        </div>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <button class="btn-primary" @onclick="CreateNewEvent">
                <span>➕</span> @AppResources.Event_New
            </button>
            <button class="btn-primary" @onclick="SaveCurrentEvent" disabled="@(string.IsNullOrWhiteSpace(_eventPlan.Title))" style="background-color: #28a745;">
                <span>💾</span> @AppResources.Button_Save
            </button>
            @if (_savedEventPlans.Any(p => p.Id == _eventPlan.Id)) {
                <button class="btn-secondary" @onclick="DeleteCurrentEvent" style="color: #dc3545;">
                    <span>🗑️</span> @AppResources.Button_Delete
                </button>
            }
        </div>
    </div>

    <!-- Event-Auswahl-Panel -->
    <div class="card-panel" style="margin-bottom: 1.5rem; padding: 1rem 1.25rem;">
        <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
            <label style="font-weight: 600; white-space: nowrap; font-size: 0.95rem;">@AppResources.Event_SavedLabel</label>
            <select class="form-control" style="flex: 1; min-width: 240px;" @onchange="OnEventSelected" value="@(_eventPlan.Id.ToString())">
                <option value="@Guid.Empty.ToString()">@AppResources.Event_NewUnsavedOption</option>
                @foreach (var plan in _savedEventPlans) {
                    <option value="@plan.Id.ToString()">@plan.Title (@plan.GuestCount Gäste)</option>
                }
            </select>
        </div>
    </div>

    <!-- Haupt-Content Layout (2-Spalten Grid) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 1.5rem; align-items: start;">

        <!-- Linke Spalte: Konfiguration & Rezeptauswahl -->
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">

            <!-- 1. Event-Parameters Panel -->
            <div class="card-panel">
                <h3 style="margin: 0 0 1rem 0; font-size: 1.1rem; font-weight: 600; border-bottom: 1px solid rgba(0,0,0,0.08); padding-bottom: 0.5rem;">
                    @AppResources.Event_Section1Title
                </h3>

                <div class="form-group">
                    <label class="form-label">@AppResources.Event_NameLabel</label>
                    <input type="text" class="form-control" @bind="_eventPlan.Title" placeholder="z. B. Sommerfest 2026" />
                </div>

                <div class="form-row">
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">@AppResources.Event_GuestCount</label>
                        <input type="number" class="form-control" @bind="_eventPlan.GuestCount" min="1" />
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">@AppResources.Event_DrinksPerGuest</label>
                        <input type="number" class="form-control" @bind="_eventPlan.AverageDrinksPerGuest" min="1" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">@AppResources.Event_FreeDrinks</label>
                        <input type="number" class="form-control" @bind="_eventPlan.FreeDrinksCount" min="0" />
                        <span class="text-muted" style="font-size: 0.75rem; display: block; margin-top: 0.2rem;">@AppResources.Event_FreeDrinksHint</span>
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">@AppResources.Event_WasteBuffer</label>
                        <input type="number" class="form-control" @bind="_eventPlan.WasteBufferPercent" min="0" max="50" />
                    </div>
                </div>
            </div>

            <!-- 2. Finanzielle Parameter (Fixkosten & Personal) -->
            <div class="card-panel">
                <h3 style="margin: 0 0 1rem 0; font-size: 1.1rem; font-weight: 600; border-bottom: 1px solid rgba(0,0,0,0.08); padding-bottom: 0.5rem;">
                    @AppResources.Event_Section2Title
                </h3>

                <div class="form-row">
                    <!-- Fixkosten mit Modal-Button -->
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">@AppResources.Event_FixedCosts</label>
                        <div style="display: flex; gap: 0.5rem;">
                            <input type="number" class="form-control" @bind="_eventPlan.FixedCosts" min="0" step="10" style="flex: 1;" />
                            <button type="button" class="btn-secondary" @onclick="OpenFixedModal" style="padding: 0.35rem 0.6rem; white-space: nowrap;" title="Fixkosten im Detail berechnen">⚙️ @AppResources.Button_Details</button>
                        </div>
                        <span class="text-muted" style="font-size: 0.75rem; display: block; margin-top: 0.2rem;">@AppResources.Event_FixedCostsHint</span>
                    </div>

                    <!-- Personalkosten mit Modal-Button -->
                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">@AppResources.Event_PersonnelCosts</label>
                        <div style="display: flex; gap: 0.5rem;">
                            <input type="number" class="form-control" @bind="_eventPlan.PersonnelCosts" min="0" step="10" style="flex: 1;" />
                            <button type="button" class="btn-secondary" @onclick="OpenPersonnelModal" style="padding: 0.35rem 0.6rem; white-space: nowrap;" title="Personalkosten im Detail berechnen">⚙️ @AppResources.Button_Details</button>
                        </div>
                        <span class="text-muted" style="font-size: 0.75rem; display: block; margin-top: 0.2rem;">@AppResources.Event_PersonnelCostsHint</span>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label">@AppResources.Event_TargetProfit</label>
                    <input type="number" class="form-control" @bind="_eventPlan.TargetProfit" min="0" step="50" />
                    <span class="text-muted" style="font-size: 0.75rem; display: block; margin-top: 0.25rem;">
                        @AppResources.Event_TargetProfitHint
                    </span>
                </div>
            </div>

            <!-- 3. Cocktails auswählen Panel -->
            <div class="card-panel">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid rgba(0,0,0,0.08); padding-bottom: 0.5rem;">
                    <h3 style="margin: 0; font-size: 1.1rem; font-weight: 600;">@AppResources.Event_Section3Title</h3>
                    @if (_eventPlan.SelectedRecipes.Count > 0) {
                        <button type="button" class="btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;" @onclick="DistributeEvenly">
                            ⚖️ @AppResources.Event_DistributeEvenly
                        </button>
                    }
                </div>

                @if (_availableRecipes.Count == 0) {
                    <div style="background-color: rgba(255, 193, 7, 0.1); border: 1px solid rgba(255, 193, 7, 0.3); border-radius: 6px; padding: 0.75rem; font-size: 0.875rem; color: #856404;">
                        @AppResources.Event_NoRecipesWarning
                    </div>
                } else {
                    <div style="max-height: 280px; overflow-y: auto; margin-bottom: 1rem; border: 1px solid rgba(0,0,0,0.08); border-radius: 6px;">
                        @foreach (var recipe in _availableRecipes) {
                            var selection = _eventPlan.SelectedRecipes.FirstOrDefault(r => r.RecipeId == recipe.Id);
                            var isSelected = selection != null;

                            <div style="padding: 0.75rem 1rem; border-bottom: 1px solid rgba(0,0,0,0.05); background-color: @(isSelected ? "rgba(var(--primary-rgb, 13, 110, 253), 0.05)" : "transparent");">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; cursor: pointer; margin: 0; font-size: 0.95rem;">
                                        <input type="checkbox"
                                               checked="@isSelected"
                                               @onchange="() => ToggleRecipeSelection(recipe)" />
                                        @recipe.Name
                                    </label>
                                    <span class="badge badge-primary">
                                        @recipe.TotalCostPerDrink.ToString("C2") / Drink
                                    </span>
                                </div>

                                @if (isSelected && selection != null) {
                                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px dashed rgba(0,0,0,0.1);">
                                        <span class="text-muted" style="font-size: 0.8rem;">@AppResources.Event_ShareLabel</span>
                                        <input type="range" style="flex: 1;" min="0" max="100" step="5"
                                               @bind="selection.Percentage" @bind:event="oninput" />
                                        <div style="display: flex; align-items: center; gap: 0.2rem; width: 75px;">
                                            <input type="number" class="form-control" style="padding: 0.2rem 0.4rem; font-size: 0.85rem; text-align: right;" min="0" max="100"
                                                   @bind="selection.Percentage" />
                                            <span style="font-size: 0.85rem;">%</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (_eventPlan.SelectedRecipes.Count > 0) {
                        var totalPercent = TotalPercentage;
                        var is100 = totalPercent == 100m;
                        <div style="background-color: @(is100 ? "rgba(40, 167, 69, 0.1)" : "rgba(220, 53, 69, 0.1)"); border: 1px solid @(is100 ? "rgba(40, 167, 69, 0.3)" : "rgba(220, 53, 69, 0.3)"); border-radius: 6px; padding: 0.6rem 0.8rem; font-size: 0.85rem; color: @(is100 ? "#155724" : "#721c24"); display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                            <span>@AppResources.Event_TotalDistribution</span>
                            <strong>@totalPercent % @(is100 ? "✓" : AppResources.Event_MustBe100)</strong>
                        </div>
                    }
                }

                <button type="button" class="btn-primary" style="width: 100%; padding: 0.75rem;"
                        @onclick="CalculateEvent"
                        disabled="@(_eventPlan.SelectedRecipes.Count == 0 || _eventPlan.GuestCount <= 0 || TotalPercentage != 100m)">
                    🧮 @AppResources.Event_CalculateBtn
                </button>
            </div>
        </div>

        <!-- Rechte Spalte: Ergebnisse & Einkaufsliste -->
        <div>
            @if (_calculationResult == null) {
                <div class="card-panel text-center" style="padding: 4rem 2rem;">
                    <p style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem;">@AppResources.Event_NoCalculationYet</p>
                    <p class="text-muted" style="margin-bottom: 0;">@AppResources.Event_NoCalculationHint</p>
                </div>
            } else {
                <div class="card-panel">
                    <!-- Ergebnis-Header -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid rgba(0,0,0,0.08); padding-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
                        <h3 style="margin: 0; font-size: 1.2rem; font-weight: 600;">@AppResources.Event_ResultPrefix @_calculationResult.EventTitle</h3>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <span class="badge badge-primary">@_calculationResult.TotalDrinksCount @AppResources.Event_PayingDrinksCount</span>
                            <button type="button" class="btn-secondary" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;" @onclick="ExportPdf">
                                📄 @AppResources.Event_ExportPdf
                            </button>
                        </div>
                    </div>

                    <!-- Kennzahlen-Grid (4 Boxen) -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem;">
                        <div class="price-preview-box text-center" style="padding: 0.6rem;">
                            <span class="text-muted" style="display: block; font-size: 0.75rem; margin-bottom: 0.1rem;">@AppResources.Event_MaterialCostTotal</span>
                            <strong style="color: #28a745; font-size: 1.1rem;">@_calculationResult.TotalMaterialCost.ToString("C2")</strong>
                        </div>
                        <div class="price-preview-box text-center" style="padding: 0.6rem;">
                            <span class="text-muted" style="display: block; font-size: 0.75rem; margin-bottom: 0.1rem;">@AppResources.Event_TotalEventCosts</span>
                            <strong style="color: #d9534f; font-size: 1.1rem;">@_calculationResult.TotalEventCosts.ToString("C2")</strong>
                        </div>
                        <div class="price-preview-box text-center" style="padding: 0.6rem;">
                            <span class="text-muted" style="display: block; font-size: 0.75rem; margin-bottom: 0.1rem;">@AppResources.Event_TargetRevenue</span>
                            <strong style="color: var(--primary); font-size: 1.1rem;">@_calculationResult.TotalTargetRevenue.ToString("C2")</strong>
                        </div>
                        <div class="price-preview-box text-center" style="padding: 0.6rem;">
                            <span class="text-muted" style="display: block; font-size: 0.75rem; margin-bottom: 0.1rem;">@AppResources.Event_AvgSalesPrice</span>
                            <strong style="color: #6f42c1; font-size: 1.1rem;">@_calculationResult.TargetSalesPricePerDrink.ToString("C2")</strong>
                        </div>
                    </div>

                    <!-- 1. Tabelle: Kalkulation pro Cocktail & Ziel-Verkaufspreis -->
                    <h4 style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.5rem;">🍹 @AppResources.Event_CocktailCalcTitle</h4>
                    <div style="overflow-x: auto; margin-bottom: 1.5rem;">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th>@AppResources.Event_TableCocktail</th>
                                    <th style="text-align: center;">@AppResources.Event_TableShare</th>
                                    <th style="text-align: center;">@AppResources.Event_TableCount</th>
                                    <th style="text-align: right;">@AppResources.Event_TableRealPerDrink</th>
                                    <th style="text-align: right; color: #6f42c1;">@AppResources.Event_TableRecommendedPrice</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var calc in _calculationResult.RecipeCalculations) {
                                    <tr>
                                        <td><strong>@calc.RecipeName</strong></td>
                                        <td style="text-align: center;">@calc.Percentage.ToString("0.##") %</td>
                                        <td style="text-align: center;">@calc.PayingDrinkCount (@calc.FreeDrinkCount) Stk.</td>
                                        <td style="text-align: right; color: #28a745;">@calc.RealCostPerDrink.ToString("C2")</td>
                                        <td style="text-align: right; font-weight: bold; color: #6f42c1;">@calc.TargetSalesPrice.ToString("C2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <span class="text-muted" style="font-size: 0.75rem; display: block; margin-top: 0.35rem;">
                            @AppResources.Event_CalcDisclaimer
                        </span>
                    </div>

                    <!-- 2. Tabelle: Einkaufsliste -->
                    <h4 style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.5rem;">🛒 @AppResources.Event_ShoppingListTitle</h4>
                    <div style="overflow-x: auto;">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th>@AppResources.Event_TableIngredient</th>
                                    <th>@AppResources.Event_TableDemand</th>
                                    <th style="text-align: center;">@AppResources.Event_TablePackage</th>
                                    <th style="text-align: right;">@AppResources.Event_TableTotalCost</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _calculationResult.ShoppingList) {
                                    <tr>
                                        <td><strong>@item.IngredientName</strong></td>
                                        <td>@item.TotalAmountNeeded.ToString("0.##") @GetUnitSuffix(item.Unit)</td>
                                        <td style="text-align: center;">
                                            <span class="badge badge-primary">
                                                @item.PackagesToBuy x (@item.PackageSize.ToString("0.##") @GetUnitSuffix(item.Unit))
                                            </span>
                                        </td>
                                        <td style="text-align: right;"><strong>@item.TotalCost.ToString("C2")</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* Ausgelagerte Modale *@
<PersonnelCostModal IsVisible="_showPersonnelModal"
                    PersonnelItems="_eventPlan.PersonnelCostItems"
                    EventPlanId="_eventPlan.Id"
                    OnSave="SavePersonnelModal"
                    OnClose="ClosePersonnelModal" />

<FixedCostModal IsVisible="_showFixedModal"
                FixedItems="_eventPlan.FixedCostItems"
                EventPlanId="_eventPlan.Id"
                OnSave="SaveFixedModal"
                OnClose="CloseFixedModal" />